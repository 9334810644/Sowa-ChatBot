{
  "name": "sowa-ai",
  "version": "1.0.0",
  "description": "Sowa AI Neural Assistant Desktop Software",
  "author": "Sowa AI",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "npx esbuild server.ts --bundle --platform=node --target=node18 --outfile=dist-electron/server.cjs --external:vite --external:electron",
    "build": "npm run build:client && npm run build:server",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive: true, force: true}); try{fs.rmSync('dist-electron', {recursive: true, force: true});}catch(e){}\"",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.sowa.ai",
    "productName": "Sowa AI",
    "copyright": "Copyright © 2026 Sowa AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.ts",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sowa AI"
    }
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
