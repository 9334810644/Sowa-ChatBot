# GEMINI_API_KEY: Required for Sowa AI features (Multimodal Live Voice & Chat).
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# GROK_API_KEY (or XAI_API_KEY): Optional for xAI Grok-2 uncensored chat, reasoning, and vision.
# Get a key at https://console.x.ai
GROK_API_KEY=""

# PORT: Optional port for running server locally (default: 3000)
PORT=3000

# Google Workspace Integration Keys (Optional: for Calendar, Tasks, Drive, Gmail)
# Create an OAuth 2.0 Client ID in Google Cloud Console with redirect URI http://localhost:3000/api/google/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""